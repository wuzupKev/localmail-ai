# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Monorepo: frontend/ (Next.js) y backend/ (.NET) conviven aqui. Las reglas van sin
# anclar a la raiz para que valgan en los dos y en video/film/, que tambien es npm.

# dependencias
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
.next/
out/

# produccion
build/

# testing
coverage/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# variables de entorno. frontend/.env.local lleva NEXT_PUBLIC_API_URL
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# salida de compilacion .NET (backend/). Ademas evita que Tailwind escanee DLLs bloqueadas
[Bb]in/
[Oo]bj/
*.user

# base de datos local del backend, si alguien la crea dentro del repo en vez de
# en %LOCALAPPDATA%/LocalMailAI/
*.db
*.db-shm
*.db-wal

# Artefactos y caches de HyperFrames. Regenerables desde compositions/ y scripts/:
# 36 MB de snapshots, contact sheets, formas de onda y renders que no son fuente.
video/film/.hyperframes/
video/film/.thumbnails/
video/film/.waveform-cache/
video/film/renders/

# Material de trabajo de la pelicula que no entra en el montaje: los originales sin
# cortar de los que salieron las tres opciones de musica, copias de seguridad y las
# audiciones de voz. Se quedan en local; el repositorio lleva solo lo que suena.
video/film/assets/bgm/candidatas/
video/film/assets/bgm/*.bak.mp3
video/film/assets/vo/muestras/

# Capturas fallidas de la web (logs de error, no fuente)
capture/
