# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Monorepo: frontend/ (Next.js) and backend/ (.NET) live side by side here. The rules
# are deliberately not anchored to the root, so they apply inside both.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
.next/
out/

# production
build/

# testing
coverage/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment. frontend/.env.local carries NEXT_PUBLIC_API_URL
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .NET build output (backend/). Also keeps Tailwind from scanning locked DLLs
[Bb]in/
[Oo]bj/
*.user

# the backend's local database, if anyone creates it inside the repository instead
# of in %LOCALAPPDATA%/LocalMailAI/
*.db
*.db-shm
*.db-wal

# Working material that is not part of the published product. It stays local:
# the launch film, the long install guide and the screenshots.
video/
docs/
capture/

# the source render: the README shows demo.gif, this stays local
demo.mp4
